{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/session_status.sh",
            "timeout": 20,
            "statusMessage": "Loading auto-research session status"
          },
          {
            "type": "command",
            "command": "bash scripts/hooks/research_bootstrap.sh",
            "timeout": 30,
            "statusMessage": "Rebuilding research context from disk"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/research_bootstrap.sh",
            "timeout": 30,
            "statusMessage": "Injecting subagent research context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/submit_guard.sh",
            "timeout": 20,
            "statusMessage": "Checking cluster submission policy"
          },
          {
            "type": "command",
            "command": "bash scripts/hooks/guard_paths.sh",
            "timeout": 20,
            "statusMessage": "Checking protected research paths"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/iter_record_nudge.sh",
            "timeout": 20,
            "statusMessage": "Checking iteration record reminders"
          },
          {
            "type": "command",
            "command": "bash scripts/hooks/wiki_reindex.sh",
            "timeout": 20,
            "statusMessage": "Refreshing wiki index if needed"
          },
          {
            "type": "command",
            "command": "bash scripts/hooks/stage_flow_nudge.sh",
            "timeout": 20,
            "statusMessage": "Checking stage order and source failures"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/loop_ledger.sh",
            "timeout": 30,
            "statusMessage": "Reconciling experiment ledger"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/precompact_flush.sh",
            "timeout": 10,
            "statusMessage": "Reminding to flush discussion before compaction"
          }
        ]
      }
    ]
  }
}
