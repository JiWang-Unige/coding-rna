# === Auto-Research 检索 API key（可选，集中存放，随框架一起走）===
#
# 用法：
#   cp secrets.env.example secrets.env     # 若 install 没自动 seed
#   编辑 secrets.env 填入真实 key
#   chmod 600 secrets.env                   # 仅自己可读
#
# 这套机制解决"挪机器要重设 key"：secrets.env 会随 install/tar 跟着框架走，
# 填一次，挪到 baobab 等新机器不必重输 key。
#
# 生效方式（两类 key 不同）：
#   • S2_API_KEY  —— scripts/lit_search.py 会**自动从本文件读取**，无需任何额外操作。
#   • EXA/ANYSEARCH_API_KEY（给 MCP 用）—— Claude Code 启动 MCP 时从**进程环境**读 ${VAR}，
#     所以要在启动 claude 前让环境里有它们。最省心做法：每台机器一次性把下面这行加进 ~/.bashrc：
#         echo "source $(pwd)/secrets.env" >> ~/.bashrc    # 在框架根目录执行；之后所有 shell 自动加载
#     （anysearch 不填也能匿名用；exa 不填则该 MCP 不可用，sota-inventory/grill 自动降级。）
#
# ⚠️ 安全：本文件已被 .gitignore（防误推公开仓库）。务必 chmod 600；
#         不要把含真实 key 的 secrets.env push 到任何公开仓库或分享给他人；
#         HPC 共享文件系统注意 home 目录权限（默认 700 即可）。
#   缺省任一 key → 对应检索源自动降级，不报错。

export S2_API_KEY=
export EXA_API_KEY=
export ANYSEARCH_API_KEY=
