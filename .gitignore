# === 密钥：绝不进版本库（随 tar 走，但不进 git）===
secrets.env
.env
.mcp.json
$LOG
.claude/settings.local.json

# Local research-agent framework (not part of this lean repository)
.agents/
.claude/
.codex/
.spec-workflow/
agents/
goals/
wiki/
worktrees/

# Python 缓存
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.DS_Store

# 杂项工具目录（非框架）
.spec-workflow/

# 备份（install 生成）
*.backup-*
*backup-*
*.bak-*
*.bak
# Heavy/runtime artifacts (keep provenance in docs/reports, not git).
# Anchored to the repository root so that source packages such as
# src/cdsgram/data/ are not swallowed by the `data/` rule.
/data/
/runs/
/outputs/
/logs/
/software_outputs/
/external_runs/
/worktrees/
/refs/pdfs/
/refs/repos/
/refs/supp/
/refs/cache/
/refs/containers/
/refs/weights/
# Reproducible, bulky prediction dumps; retain compact reports and metrics.
# (reports now live under experiments/<group>/reports/, benchmarks/*/reports/, ...)
**/reports/**/predictions/
*.pt
*.pth
*.ckpt
*.h5

# The old framework's HPC-only exclude list (.git/info/exclude of the original
# clone) hides README.md, AGENTS.md, CLAUDE.md and manuscript/. This repository
# tracks its own copies, so re-include them explicitly.
!README.md
!AGENTS.md
!CLAUDE.md
!/paper/manuscript/
